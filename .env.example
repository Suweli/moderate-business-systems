# Brevo newsletter integration
# Create a Brevo account, create or choose a mailing list, then copy the values below into `.env.local`.
# BREVO_API_KEY: Brevo API v3 key with contact management permission.
# BREVO_NEWSLETTER_LIST_ID: Numeric Brevo list ID where newsletter subscribers should be stored.

BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=