# Brevo newsletter integration
# Create a Brevo account, create or choose a mailing list, then copy the values below into `.env.local`.
# BREVO_API_KEY: Brevo API v3 key with contact management permission.
# BREVO_NEWSLETTER_LIST_ID: Numeric Brevo list ID where newsletter subscribers should be stored.

BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=

# Testimonials moderation API key (required for approve/reject endpoint)
TESTIMONIAL_MODERATION_KEY=

# Optional testimonial moderation email settings
# TESTIMONIAL_APPROVAL_RECIPIENT defaults to moderatebiz@yahoo.com if omitted.
TESTIMONIAL_APPROVAL_RECIPIENT=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Testimonials database and admin authentication
DATABASE_URL=
# Set true if your Postgres provider requires SSL (most managed providers do).
DATABASE_SSL=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_AUTH_SECRET=

# Optional admin hardening
# Comma-separated list of allowed client IP addresses for admin routes.
# Use exact IP values only (no CIDR support in current implementation).
# Examples:
# Development (local only):
# ADMIN_ALLOWED_IPS=127.0.0.1,::1
# Production (replace with your trusted public IPs):
# ADMIN_ALLOWED_IPS=41.190.2.15,102.89.34.220
ADMIN_ALLOWED_IPS=
# Login rate limit window and max attempts within that window.
ADMIN_LOGIN_WINDOW_SECONDS=900
ADMIN_MAX_LOGIN_ATTEMPTS=8